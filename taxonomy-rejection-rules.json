  {
    "id": "rr-bidlaw-42",
    "kind": "rejection_rule",
    "tender_type": "工程",
    "category": "符合性",
    "title": "否决所有投标后应重新招标",
    "requirement": "招标投标法第四十二条针对依法必须招标项目。与政府采购法「废标」用语不同，分行。",
    "source_quote": "评标委员会经评审，认为所有投标都不符合招标文件要求的，可以否决所有投标。依法必须进行招标的项目的所有投标被否决的，招标人应当依照本法重新招标。",
    "source_url": "http://npc.people.com.cn/n1/2018/0105/c14576-29747940.html",
    "source_note": "招标投标法第四十二条",
    "source_publisher": "npc",
    "anonymization": "statute",
    "year": 2018,
    "is_mandatory": true,
    "incomparability_note": "工程招标投标法用「否决所有投标」；政府采购法用「废标」。",
    "points": null,
    "region": "全国",
    "updated_at": "2026-09-10"
