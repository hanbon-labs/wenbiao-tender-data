    "id": "rr-gpl-36-1",
    "kind": "rejection_rule",
    "tender_type": "法规通则",
    "category": "符合性",
    "title": "废标：实质响应供应商不足三家",
    "requirement": "政府采购法第三十六条第一项。废标是整场采购活动终止，不是单份投标被否决。",
    "source_quote": "在招标采购中，出现下列情形之一的，应予废标：（一）符合专业条件的供应商或者对招标文件作实质响应的供应商不足三家的；",
    "source_url": "https://www.ccgp.gov.cn/zcfg/gjfg/201310/t20131029_3587339.htm",
    "source_note": "政府采购法第三十六条",
    "source_publisher": "ccgp",
    "anonymization": "statute",
    "year": 2014,
    "is_mandatory": true,
    "incomparability_note": "废标终止整场；投标无效/否决只针对单个投标人。",
    "points": null,
    "region": "全国",
    "updated_at": "2026-09-10"
  },
